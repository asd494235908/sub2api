# Local rehearsal environment for v0.1.120 validation
# Copy to .env.localtest and adjust only if needed.

COMPOSE_PROJECT_NAME=sub2api-rehearsal
SUB2API_IMAGE=sub2api-local:v0.1.120-rehearsal

BIND_HOST=127.0.0.1
SERVER_PORT=18080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

ADMIN_EMAIL=admin-local@sub2api.local
ADMIN_PASSWORD=LocalTest123!
JWT_SECRET=replace_with_a_random_hex_secret
TOTP_ENCRYPTION_KEY=replace_with_a_random_hex_secret

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=sub2api
LOCALTEST_POSTGRES_PORT=15432

DATABASE_HOST=host.docker.internal
DATABASE_PORT=15432
DATABASE_USER=sub2api
DATABASE_PASSWORD=replace_with_a_strong_password
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=64
DATABASE_MAX_IDLE_CONNS=16
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

REDIS_PASSWORD=replace_with_a_strong_password
REDIS_DB=0
LOCALTEST_REDIS_PORT=16379
REDIS_HOST=host.docker.internal
REDIS_PORT=16379
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10
REDIS_ENABLE_TLS=false
